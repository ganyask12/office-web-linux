#!/usr/bin/env python3
"""office-web open <file>  - upload a local file to OneDrive and open it in the Office web apps.
office-web save <file>  - pull the edited version back, replace the local file, remove the OneDrive copy (recycle bin).
Sign-in comes from rclone (remote "od"). Messages follow the system language (uk / en)."""
import sys, os, re, time, json, subprocess, urllib.request, urllib.parse, urllib.error, tempfile, shutil

_LANG = (os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "").lower()


def _(uk, en):
    return uk if _LANG.startswith("uk") else en


API = "https://graph.microsoft.com/v1.0"
FOLDER = "_pc-temp"
STATE = os.path.expanduser("~/.local/share/office-web/state.json")
MAX = 250 * 1024 * 1024


def notify(text, bad=False):
    print(text)
    subprocess.run(["notify-send", "-i", "dialog-error" if bad else "dialog-information", "Office (web)", text], check=False)


def token():
    # any rclone command refreshes an expired token in its config
    subprocess.run(["rclone", "lsd", "od:", "--max-depth", "0"], capture_output=True, check=False)
    cfg = json.loads(subprocess.run(["rclone", "config", "dump"], capture_output=True, text=True, check=True).stdout)
    return json.loads(cfg["od"]["token"])["access_token"]


def call(method, path, data=None, tok=None, raw=False):
    req = urllib.request.Request(API + path, data=data, method=method, headers={"Authorization": "Bearer " + tok})
    try:
        with urllib.request.urlopen(req, timeout=300) as r:
            body = r.read()
            return body if raw else (json.loads(body) if body else {})
    except urllib.error.HTTPError as e:
        raise RuntimeError("OneDrive %s: %s" % (e.code, e.read()[:200].decode(errors="replace")))


def load():
    try:
        return json.load(open(STATE))
    except Exception:
        return {}


def store(s):
    json.dump(s, open(STATE, "w"), ensure_ascii=False, indent=1)


def reopen_existing(path):
    """Already opened before: if the copy is still in OneDrive, reopen it instead of uploading a duplicate."""
    it = load().get(path)
    if not it:
        return False
    try:
        call("GET", "/me/drive/items/%s?select=id" % it["id"], tok=token())
    except RuntimeError:
        s = load(); s.pop(path, None); store(s)  # the copy is gone - upload again
        return False
    subprocess.Popen(["google-chrome-stable", "--profile-directory=" + os.environ.get("OFFICE_WEB_PROFILE", "Default"), "--app=" + it["webUrl"]])
    notify(_("«%s» відкрито знову (та сама копія в OneDrive).", "\"%s\" reopened (same copy in OneDrive).") % os.path.basename(path))
    return True


def cmd_open(path):
    if reopen_existing(path):
        return
    size = os.path.getsize(path)
    if size > MAX:
        raise RuntimeError(_("Файл більший за 250 МБ", "File is larger than 250 MB"))
    name = os.path.basename(path)
    tok = token()
    q = "/me/drive/root:/%s/%s:/content?@microsoft.graph.conflictBehavior=rename" % (FOLDER, urllib.parse.quote(name))
    item = call("PUT", q, open(path, "rb").read(), tok)
    s = load()
    s[path] = {"id": item["id"], "name": item["name"], "webUrl": item["webUrl"]}
    store(s)
    subprocess.Popen(["google-chrome-stable", "--profile-directory=" + os.environ.get("OFFICE_WEB_PROFILE", "Default"), "--app=" + item["webUrl"]])
    notify(_("«%s» відкрито у веб-Office. Коли закінчите — «Зберегти зміни з Office (веб)».", "\"%s\" is open in Office on the web. When done, use \"Save changes from Office (web)\".") % name)


def norm(x):
    return re.sub(r"[^0-9a-f]", "", x.lower())


def entry_by_resid(resid):
    for path, it in load().items():
        if norm(resid) and (norm(resid) in norm(it["id"]) or norm(resid) in norm(it["webUrl"])):
            return path, it
    raise RuntimeError(_("Не знайшов, який файл на ПК відповідає цьому документу (відкривайте через «Відкрити в Office (веб)»).", "Cannot tell which local file this document belongs to (open it via \"Open in Office (web)\")."))


def pull(path, it):
    """Download the current version from OneDrive and atomically replace the file at path."""
    tok = token()
    meta = call("GET", "/me/drive/items/%s?select=size,@microsoft.graph.downloadUrl" % it["id"], tok=tok)
    # the direct download URL needs no token (it rejects requests that carry one)
    with urllib.request.urlopen(meta["@microsoft.graph.downloadUrl"], timeout=300) as r:
        blob = r.read()
    if len(blob) != meta["size"]:
        raise RuntimeError(_("Розмір завантаженого файлу не збігається — нічого не змінено.", "Downloaded size does not match - nothing was changed."))
    with tempfile.NamedTemporaryFile(dir=os.path.dirname(path), delete=False, prefix=".office-web-") as t:
        t.write(blob)
    if os.path.exists(path):
        shutil.copymode(path, t.name)
    os.replace(t.name, path)


def cleanup(path, it):
    """Remove the OneDrive copy (recycle bin). While the document is open OneDrive keeps it locked, so we wait."""
    name = os.path.basename(path)
    for i in range(300):  # up to ~20 minutes
        try:
            call("DELETE", "/me/drive/items/%s" % it["id"], tok=token())
            break
        except RuntimeError as e:
            if "423" not in str(e) or i == 299:
                raise RuntimeError(_("«%s» оновлено на ПК, але з OneDrive не видалено: %s", "\"%s\" updated locally but not removed from OneDrive: %s") % (name, e))
            if i == 0:
                notify(_("«%s» оновлено на ПК. Закрийте вікно документа — тоді приберу копію з OneDrive.", "\"%s\" updated locally. Close the document window and I will remove the OneDrive copy.") % name)
            time.sleep(4)
    s = load()
    s.pop(path, None)
    store(s)
    notify(_("«%s»: копію прибрано з OneDrive.", "\"%s\": OneDrive copy removed.") % name)


def cmd_save(path):
    s = load()
    if path not in s:
        raise RuntimeError(_("Цей файл не відкривався через «Відкрити в Office (веб)».", "This file was not opened via \"Open in Office (web)\"."))
    pull(path, s[path])
    cleanup(path, s[path])


def cmd_save_resid(resid):
    path, it = entry_by_resid(resid)
    pull(path, it)
    notify(_("«%s» збережено на ПК (замінено оригінал).", "\"%s\" saved to your PC (original replaced).") % os.path.basename(path))


def cmd_saveas_resid(resid):
    path, it = entry_by_resid(resid)
    r = subprocess.run(["zenity", "--file-selection", "--save", "--confirm-overwrite", "--title=" + _("Зберегти як", "Save as"),
                        "--filename=" + path], capture_output=True, text=True)
    new = r.stdout.strip()
    if r.returncode != 0 or not new:
        return
    pull(new, it)
    notify(_("Збережено як «%s». Оригінал на ПК не змінено.", "Saved as \"%s\". The original is unchanged.") % os.path.basename(new))


def cmd_finish_resid(resid):
    path, _ = entry_by_resid(resid)
    cmd_save(path)


if __name__ == "__main__":
    try:
        cmds = {"open": cmd_open, "save": cmd_save}
        if sys.argv[1] in cmds:
            cmds[sys.argv[1]](os.path.realpath(sys.argv[2]))
        else:
            {"save-resid": cmd_save_resid, "saveas-resid": cmd_saveas_resid, "finish-resid": cmd_finish_resid}[sys.argv[1]](sys.argv[2])
    except Exception as e:
        notify(str(e), True)
        sys.exit(1)
