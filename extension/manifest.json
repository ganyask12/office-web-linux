{
  "manifest_version": 3,
  "name": "Office ПК-міст",
  "version": "3.0",
  "description": "Кнопки «Зберегти на ПК», «Зберегти як…» і «Готово» у вікні Word/Excel online для файлів, відкритих через office-web.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://onedrive.live.com/*/_layouts/15/*",
        "https://onedrive.live.com/edit*"
      ],
      "js": [
        "doc-ui.js"
      ],
      "run_at": "document_idle"
    }
  ]
}